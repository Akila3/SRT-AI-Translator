{
  "name": "srt-ai-translation-ui",
  "version": "1.1.0",
  "description": "Electron + React desktop UI for the gemini-srt-translator CLI",
  "main": "./out/main/index.js",
  "author": "SRT AI Translation UI",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:gates": "node scripts/gates/run.mjs",
    "build:python": "python scripts/build_python.py",
    "check:bin": "node scripts/check-bin.mjs",
    "verify:live": "node scripts/verify/run.mjs",
    "verify:consolelog": "node scripts/verify/run-consolelog.mjs",
    "build:win": "node scripts/check-bin.mjs --target=win32 && electron-vite build && electron-builder --win",
    "build:dir": "npm run check:bin && electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  },
  "build": {
    "appId": "com.srtai.translationui",
    "productName": "SRT AI Translator",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "gst*",
          "ffmpeg*",
          "ffprobe*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": "zip"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
